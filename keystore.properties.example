# RollerSkater Release Signing Configuration Template
#
# Copy this file to 'keystore.properties' (which is git-ignored) to sign release builds:
#   cp keystore.properties.example keystore.properties
#
# To generate a new production release keystore, run:
#   keytool -genkey -v -keystore release.jks -alias rollerskater -keyalg RSA -keysize 2048 -validity 10000
#
# Fill in the path to your .jks file and the matching credentials below:
storeFile=release.jks
storePassword=your_store_password_here
keyAlias=rollerskater
keyPassword=your_key_password_here
