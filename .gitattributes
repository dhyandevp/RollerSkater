# Set default behavior to automatically handle line endings
* text=auto eol=lf

# Explicit text files with LF line endings
*.kt text eol=lf diff=kotlin
*.kts text eol=lf diff=kotlin
*.java text eol=lf diff=java
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Windows batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.so binary
*.aar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.rsk binary
*.mp3 binary
*.flac binary
*.ogg binary
*.opus binary
*.wav binary
*.m4a binary
